# Host-specific settings for deploy.sh.
#
#   cp deploy.env.example deploy.env    # then edit; deploy.env is not tracked
#
# With this file in place, deploying stays a single command with no flags:
#
#   ./deploy.sh v1.2.0
#
# Every value below is optional — deploy.sh has working defaults for all of
# them. Set only what differs on your host. An environment variable set on the
# command line still overrides anything here, for one-off runs.

# Production checkout. Must be a directory separate from the one you develop in:
# deploying a tag leaves it in detached HEAD. See docs/DEPLOYMENT.md.
#EVERFLY_SRC_DIR=/opt/everfly

# Compose file to drive. Defaults to $EVERFLY_SRC_DIR/docker-compose.yml.
# Point this elsewhere if your compose file and its .env live outside the
# checkout — which is recommended, so secrets are not in a directory that
# deployments overwrite.
#EVERFLY_COMPOSE_FILE=/srv/everfly-deploy/docker-compose.yml

# Compose project name. Change this only if you already have a project under a
# different name — renaming it recreates the container.
#EVERFLY_COMPOSE_PROJECT=everfly

# Container name, as set by container_name: in the compose file.
#EVERFLY_CONTAINER=everfly-app

# Health endpoint polled after startup, and how long to wait before declaring
# the deploy failed.
#EVERFLY_HEALTH_URL=http://127.0.0.1:5000/api/health
#EVERFLY_HEALTH_TIMEOUT=120
