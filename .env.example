# Copy this file to .env and fill in your values

# Encryption key for FlightAware API keys stored in DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_SECRET_KEY=

# Flask session signing key — use a long random string
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to true for local development; set to false (or remove) in production
FLASK_DEBUG=false

# Invitation code required for new user registration
INVITATION_CODE=

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=flightlog
MYSQL_PASSWORD=
MYSQL_DB=flightlog

# Optional ImageKit airline logo storage
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Internal service API used by everInbox to create minimal everfly flight drafts.
INTERNAL_SERVICE_TOKEN=
EVERFLY_INTERNAL_USERNAME=yongxue
