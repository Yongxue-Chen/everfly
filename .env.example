# Copy this file to .env and fill in your values

# Encryption key for FlightAware API keys stored in DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_SECRET_KEY=

# Flask session signing key — use a long random string
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to true for local development; set to false (or remove) in production
FLASK_DEBUG=false

# Session cookie is HTTPS-only by default. Set to false only for plain-HTTP
# local development, otherwise the login cookie is never stored by the browser.
SESSION_COOKIE_SECURE=true

# Invitation code required for new user registration
INVITATION_CODE=

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=everfly
MYSQL_PASSWORD=
MYSQL_DB=everfly

# Optional ImageKit airline logo storage
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Internal service API: lets a trusted sibling service create minimal flight
# drafts in everfly. Leave INTERNAL_SERVICE_TOKEN empty to disable the endpoint.
# EVERFLY_INTERNAL_USERNAME must match an existing username in the users table.
INTERNAL_SERVICE_TOKEN=
EVERFLY_INTERNAL_USERNAME=

# Optional single sign-on through a trusted cookie set by a sibling app on the
# shared parent domain (see sso.py). Disabled unless SSO_SECRET and SSO_LOGIN_URL
# are set. SSO_USER_MAP maps the provider's email to an everfly username.
SSO_SECRET=
SSO_LOGIN_URL=
SSO_LOGOUT_URL=
SSO_CHECK_URL=
SSO_USER_MAP=
SSO_PROVIDER_NAME=
